# === Server-only secrets ===
PORT=3010
ADMIN_SECRET=replace_with_a_secure_admin_secret
APP_SECRET=replace_with_a_secure_app_secret
PROFILE_TOKEN_SECRET=replace_with_a_secure_profile_token_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy fallback retained until migration is complete:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_supabase_service_role_key
SUPABASE_ASSIGNMENT_BUCKET=assignment-files
SUPABASE_SUBMISSION_BUCKET=submission-files
SUPABASE_REGISTRATIONS_TABLE=registrations
SUPABASE_REGISTRATION_TABLE=registration_data

# SMTP settings for OTP email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=SVU Assessment.com <your_email@gmail.com>

# === Public / browser-safe variables ===
FRONTEND_URL=http://localhost:3000

# Optional app tuning
JSON_BODY_LIMIT=5mb
OTP_TTL_MS=300000
OTP_CLOCK_SKEW_MS=30000
